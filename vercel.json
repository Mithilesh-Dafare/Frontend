{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    { "src": "/assets/(.*)", "dest": "/assets/$1" },
    { "src": "/images/(.*)", "dest": "/images/$1" },
    { "src": "/js/(.*)", "dest": "/js/$1" },
    { "src": "/components/(.*)", "dest": "/components/$1" },
    { "src": "/(.*\\.js$)", "dest": "/$1" },
    { "src": "/(.*\\.css$)", "dest": "/$1" },
    { "src": "/(.*\\.(jpg|jpeg|png|svg|ico|webp|avif|pdf))", "dest": "/$1" },
    { "src": "/(.*\\.html$)", "dest": "/$1" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
