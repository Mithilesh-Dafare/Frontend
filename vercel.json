{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist",
        "env": {
          "NODE_VERSION": "16.x"
        }
      }
    }
  ],
  "routes": [
    { "src": "/assets/(.*)", "dest": "/assets/$1" },
    { "src": "/images/(.*)", "dest": "/images/$1" },
    { "src": "/(.*\\.(css|js|jpg|jpeg|png|svg|ico|json|html|pdf|webp|avif))", "dest": "/$1" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
